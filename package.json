{
  "name": "careloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @careloop/web --filter @careloop/api dev",
    "dev:web": "pnpm --filter @careloop/web dev",
    "dev:api": "pnpm --filter @careloop/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "demo:seed": "python scripts/seed_demo.py",
    "demo:reset": "python scripts/reset_demo.py",
    "setup:supabase": "tsx scripts/setup-supabase.ts",
    "verify:supabase": "tsx scripts/verify-supabase.ts",
    "typecheck:supabase": "tsc -p scripts/tsconfig.json",
    "test:supabase-tools": "tsx --test scripts/supabase-tools.test.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.57.4",
    "@types/node": "26.6.2",
    "prettier": "^3.4.2",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "^5.7.2"
  }
}
